{
  "name": "freshdash-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:up": "docker-compose up -d postgres redis",
    "db:migrate": "pnpm --filter @freshdash/server prisma migrate dev",
    "db:generate": "pnpm --filter @freshdash/server prisma generate"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
