generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  openId    String   @unique @map("open_id")
  nickName  String?  @map("nick_name")
  avatarUrl String?  @map("avatar_url")
  phone     String?
  isPromoter Boolean @default(false) @map("is_promoter")
  promoterCode String? @unique @map("promoter_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]
  commissions Commission[]
  promoter  Promoter?

  @@map("users")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  coverImage   String   @map("cover_image")
  price        Int
  originalPrice Int?    @map("original_price")
  unit         String
  tags         String[]
  categoryId   String   @map("category_id")
  stock        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orderItems   OrderItem[]

  @@map("products")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Order {
  id          String      @id @default(uuid())
  orderNo     String      @unique @map("order_no")
  userId      String      @map("user_id")
  supplierId  String?     @map("supplier_id")
  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount Int         @map("total_amount")
  address     String?
  trackingNo  String?     @map("tracking_no")
  shippedAt   DateTime?   @map("shipped_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  items      OrderItem[]
  commission Commission?

  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  productName String @map("product_name")
  productImage String @map("product_image")
  price     Int
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Commission {
  id           String @id @default(uuid())
  orderId      String @unique @map("order_id")
  promoterId   String @map("promoter_id")
  amount       Int
  status       CommissionStatus @default(PENDING)
  settledAt    DateTime? @map("settled_at")
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order @relation(fields: [orderId], references: [id])
  promoter User @relation(fields: [promoterId], references: [id])

  @@map("commissions")
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_DISPATCH
  PENDING_SHIPMENT
  SHIPPED
  COMPLETED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  SETTLED
  WITHDRAWN
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  phone     String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]

  @@map("suppliers")
}

model Promoter {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  totalCommission Int     @default(0) @map("total_commission")
  balance        Int      @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id])
  withdrawals Withdrawal[]

  @@map("promoters")
}

model Withdrawal {
  id          String           @id @default(uuid())
  promoterId  String           @map("promoter_id")
  amount      Int
  status      WithdrawalStatus @default(PENDING)
  reviewedAt  DateTime?        @map("reviewed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  promoter Promoter @relation(fields: [promoterId], references: [id])

  @@map("withdrawals")
}

model Banner {
  id        String   @id @default(uuid())
  title     String?
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  sort      Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}
